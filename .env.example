# URL วิดีโอที่คุณมีสิทธิ์ทดสอบ
VIDEO_URL=https://www.youtube.com/watch?v=VIDEO_ID
SEARCH_TERMS_FILE=data/search-terms.txt

# true = เห็นหน้าต่างเบราว์เซอร์, false = ทำงานเบื้องหลัง
HEADLESS=true
OPEN_DEVTOOLS=false
# Keep Chromium open after npm run auth and let npm run dev attach to it.
REUSE_EXISTING_CHROME=false
# CHROME_DEBUGGING_PORT=9222
KEEP_OPEN=false
ACTION_DELAY_MS=2000
# Random session duration. Set both values to the same number for an exact duration.
MIN_RUN_HOURS=2
MAX_RUN_HOURS=4
# Random wait before the browser starts. Set both values to 0 to start immediately.
MIN_START_DELAY_ON=true
MIN_START_DELAY_MINUTES=1
MAX_START_DELAY_MINUTES=20

# On Linux/Raspberry Pi, the system Chromium is used automatically.
# The default automation profile is .youtube-profile; log in to YouTube there once using npm run auth.
# Optional overrides:
# BROWSER_PATH=/usr/bin/chromium
# BROWSER_PROFILE_DIR=/path/to/a-separate-automation-profile
# BROWSER_PROFILE_NAME=Default
