# URL วิดีโอที่คุณมีสิทธิ์ทดสอบ
VIDEO_URL=https://www.youtube.com/watch?v=VIDEO_ID
SEARCH_TERMS_FILE=data/search-terms.txt

# true = เห็นหน้าต่างเบราว์เซอร์, false = ทำงานเบื้องหลัง
HEADLESS=true
KEEP_OPEN=false
ACTION_DELAY_MS=2000

# On Linux/Raspberry Pi, the system Chromium and the user's Chromium profile are used automatically.
# Close every Chromium window before running the script, because a profile can only be used by one browser at a time.
# Optional overrides:
# BROWSER_PATH=/usr/bin/chromium
# BROWSER_PROFILE_DIR=/home/test/.config/chromium
